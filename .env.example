# Copy to .env and change before using anywhere other than a local demo.
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor
JWT_SECRET=change-me-in-production
WEB_PORT=8080
SIM_INTERVAL_SECONDS=5
STALE_AFTER_SECONDS=20
METRICS_RETENTION_DAYS=7

# Only for docker-compose.oracle.yml (Oracle installed on this computer).
# ORACLE_SERVICE is the PDB service name: XEPDB1 (XE 18c/21c), FREEPDB1 (Free 23ai), ORCLPDB (EE default).
ORACLE_USER=monitor
ORACLE_PASSWORD=monitor
ORACLE_HOST=host.docker.internal
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
